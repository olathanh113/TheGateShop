# Checklist only. The module does not automatically load a .env file.
# Export these values or inject them with the approved service manager/secret manager.
# Runtime data, logs and the KiotViet secret file must use absolute private paths
# outside the source checkout and web root.
KIOT_CATALOG_DATA_DIR=/absolute/private/path/to/catalog-data
KIOT_CATALOG_LOG_DIR=/absolute/private/path/to/catalog-logs
KIOT_CATALOG_SECRETS_PATH=/absolute/private/path/to/kiot_secret.env

# Never commit real values and never expose either key in browser JavaScript.
KIOT_CATALOG_WEBSITE_API_KEY=CHANGE_ME_WITH_RANDOM_WEBSITE_KEY
KIOT_CATALOG_INTERNAL_API_KEY=CHANGE_ME_WITH_DIFFERENT_RANDOM_INTERNAL_KEY

# Local-only defaults.
KIOT_CATALOG_DEPLOYMENT_MODE=local
KIOT_CATALOG_HOST=127.0.0.1
KIOT_CATALOG_PORT=8787
KIOT_CATALOG_MAX_PAGE_SIZE=100
KIOT_CATALOG_RATE_LIMIT_PER_MINUTE=120
KIOT_CATALOG_WEBSITE_RATE_LIMIT_PER_MINUTE=600
KIOT_CATALOG_WEBSITE_MAX_AGE_SECONDS=10800
KIOT_CATALOG_WEBSITE_MAX_PRODUCTS=1000
KIOT_CATALOG_WEBSITE_MAX_RESPONSE_BYTES=5000000

# Bounded read-only KiotViet request behavior.
KIOT_CATALOG_REQUEST_TIMEOUT_SECONDS=60
KIOT_CATALOG_REQUEST_ATTEMPTS=4
KIOT_CATALOG_REQUEST_MIN_INTERVAL_SECONDS=0.12
KIOT_CATALOG_PAGE_SIZE=100

# Owner-approved operating targets. No scheduler is created by this module.
KIOT_CATALOG_MAX_CACHE_AGE_SECONDS=10800
KIOT_CATALOG_RETAIN_GENERATIONS=3
# Local `serve` does not start a worker. The Railway entrypoint uses an in-process
# 3600-second worker only when explicit railway deployment mode is configured.
