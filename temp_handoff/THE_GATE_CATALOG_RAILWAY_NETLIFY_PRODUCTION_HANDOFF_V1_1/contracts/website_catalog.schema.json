{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thegate.example.invalid/contracts/website-catalog-v1.schema.json",
  "title": "The Gate website catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_data_as_of", "total", "items"],
  "properties": {
    "schema_version": {"const": "the_gate_website_catalog.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_data_as_of": {"type": "string", "format": "date-time"},
    "total": {"type": "integer", "minimum": 0, "maximum": 1000},
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "slug", "attributes", "images", "sale_price", "price_status", "availability", "source_group", "category", "audience", "collection", "display_order", "featured", "data_as_of"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120},
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "size"],
            "properties": {"color": {"type": ["string", "null"]}, "size": {"type": ["string", "null"]}}
          },
          "images": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
          "sale_price": {"type": "number", "exclusiveMinimum": 0},
          "price_status": {"const": "available"},
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ton_that_thiep", "nguyen_trai", "tam_coc"],
            "properties": {
              "ton_that_thiep": {"enum": ["in_stock", "out_of_stock", "unavailable"]},
              "nguyen_trai": {"enum": ["in_stock", "out_of_stock", "unavailable"]},
              "tam_coc": {"enum": ["in_stock", "out_of_stock", "unavailable"]}
            }
          },
          "source_group": {"type": ["string", "null"]},
          "category": {"type": ["string", "null"]},
          "audience": {"type": ["string", "null"]},
          "collection": {"type": ["string", "null"]},
          "display_order": {"type": ["integer", "null"], "minimum": 0},
          "featured": {"type": "boolean"},
          "data_as_of": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
